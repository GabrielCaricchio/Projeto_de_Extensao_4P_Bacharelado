# =================================================================
# CyberTech — Configuração de Ambiente para Execução Completa
# =================================================================

# 1. Chatbot API (Groq)
# Obtenha sua chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=troque-pela-sua-chave-do-groq
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Back-end Spring Boot
SERVER_PORT=8080
CHATBOT_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:80,http://localhost

# 3. Front-end Angular
# O front-end conecta-se por padrão ao backend em http://localhost:8080 ou /api
